APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_TIMEOUT=20
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=one-contract.net
MAIL_PUBLIC_URL=https://one-contract.net
MAIL_IMAGE_BASE_URL=https://one-contract.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# NowPayments (required for /dashboard/deposit)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true
NOWPAYMENTS_PAY_CURRENCY=usdttrc20
NOWPAYMENTS_CHECKOUT_ENDPOINT=/v1/invoice
# Optional: defaults to ${APP_URL}/nowpayments/ipn when unset
NOWPAYMENTS_IPN_CALLBACK_URL=
# Optional: defaults to ${APP_URL}/dashboard/deposit/return and /dashboard/deposit
NOWPAYMENTS_SUCCESS_URL=
NOWPAYMENTS_CANCEL_URL=
NOWPAYMENTS_CUSTODY_EMAIL=
NOWPAYMENTS_CUSTODY_PASSWORD=

MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT=

# Dojah KYC / liveness / transaction monitoring (also configurable in Admin → KYC Settings)
DOJAH_PUBLIC_KEY=
DOJAH_SECRET_KEY=
DOJAH_APP_ID=
DOJAH_INGEST_KEY=
DOJAH_SANDBOX_PUBLIC_KEY=
DOJAH_SANDBOX_SECRET_KEY=
DOJAH_SANDBOX_APP_ID=
DOJAH_SANDBOX_INGEST_KEY=

WALLET_PLATFORM_CONVERSION_FEE_PERCENT=1.0

# Google OAuth (required for Connect Google Account / Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to ${APP_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=
